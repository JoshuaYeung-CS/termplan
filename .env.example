# Nebius Token Factory API key (Token Factory console -> API keys). Never commit the real one.
NEBIUS_API_KEY=
# OpenAI-compatible endpoint, from https://docs.tokenfactory.nebius.com/quickstart
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# NVIDIA Nemotron model ID. Run scripts/check_models.py to list the ones your key can call.
TERMPLAN_MODEL=nvidia/Nemotron-3_5-Lightning
# Optional: a different (larger) Nemotron model for the coach step. Defaults to TERMPLAN_MODEL.
TERMPLAN_COACH_MODEL=
# Set to 1 to run fully offline against the built-in stub (no model calls).
TERMPLAN_STUB=0
# Public-demo guards: plans per client IP per hour, and concurrent plans.
TERMPLAN_RATE_LIMIT=30
TERMPLAN_MAX_CONCURRENT=3
